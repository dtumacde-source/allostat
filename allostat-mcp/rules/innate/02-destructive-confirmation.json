{
  "id": "innate-02",
  "name": "Always require explicit confirmation before destructive commands",
  "severity": "lethal",
  "tier": "innate",
  "description": "Any command capable of permanent data loss requires explicit chat confirmation — shell deletion in every spelling (rm, find -delete, shred, dd, truncate), git history/branch destruction, SQL drops, AND named destructive cloud operations (aws/gh/wrangler/stripe, keyed by service+subcommand, never by a bare verb). Operator authorization once is not standing authorization for future invocations — each destructive action gets its own confirmation.\n",
  "trigger": {
    "match_any": [
      {
        "command_pattern": "(?<!-)\\brm\\s+-[a-zA-Z]*[rf][a-zA-Z]*\\b",
        "case_sensitive": false
      },
      {
        "command_pattern": "(?<!-)\\brm\\s+(-[a-zA-Z]*\\s+)*--(recursive|force)\\b",
        "case_sensitive": false
      },
      {
        "command_pattern": "git\\s+reset\\s+--hard"
      },
      {
        "command_pattern": "git\\s+push\\s+.*--force"
      },
      {
        "command_pattern": "git\\s+push\\s+.*-f\\b"
      },
      {
        "command_pattern": "git\\s+push\\s+[^|;&]*\\s\\+\\S"
      },
      {
        "command_pattern": "git\\s+branch\\s+-D"
      },
      {
        "command_pattern": "git\\s+clean\\s+-(f|x)"
      },
      {
        "command_pattern": "git\\s+checkout\\s+(--(\\s|$)|\\.)"
      },
      {
        "command_pattern": "git\\s+checkout(?=[^\\n;&|]*\\s(?:--force|-f)\\b)"
      },
      {
        "command_pattern": "git\\s+restore\\s+\\."
      },
      {
        "command_pattern": "DROP\\s+TABLE",
        "case_sensitive": false
      },
      {
        "command_pattern": "DROP\\s+DATABASE",
        "case_sensitive": false
      },
      {
        "command_pattern": "\\bTRUNCATE\\b",
        "case_sensitive": false
      },
      {
        "command_pattern": "format\\s+/[a-zA-Z]:"
      },
      {
        "command_pattern": "(?<!-)\\b(Remove-Item|ri|rm|rd|rmdir|del|erase)\\b[^|;&]*\\s-{1,2}r(e(c(u(r(s(e)?)?)?)?)?)?\\b",
        "case_sensitive": false
      },
      {
        "command_pattern": "\\b(Get-ChildItem|gci)\\b[^;&]*\\s-{1,2}r(e(c(u(r(s(e)?)?)?)?)?)?\\b[^;&]*\\b(Remove-Item|ri|del|erase)\\b",
        "case_sensitive": false
      },
      {
        "command_pattern": "\\[[^\\]]*Directory\\]::Delete",
        "case_sensitive": false
      },
      {
        "command_pattern": "\\b(rd|rmdir)\\b(?=.*/s\\b)",
        "case_sensitive": false
      },
      {
        "command_pattern": "\\bdel\\b(?=.*/s\\b)",
        "case_sensitive": false
      },
      {
        "command_pattern": "(?:^|[\\n;&|`]|\\$\\()\\s*(?:sudo\\s+(?:-\\w+\\s+)*)?(?:command\\s+)?(?:env\\s+)?(?:\\w+=\\S*\\s+)*find\\s(?=[^\\n;&|]*\\s-delete\\b)"
      },
      {
        "command_pattern": "(?:^|[\\n;&|`]|\\$\\()\\s*(?:sudo\\s+(?:-\\w+\\s+)*)?(?:command\\s+)?(?:env\\s+)?(?:\\w+=\\S*\\s+)*find\\s(?=[^\\n;&|]*\\s-exec\\s+(?:rm|shred)\\b)"
      },
      {
        "command_pattern": "(?:^|[\\n;&|`]|\\$\\()\\s*(?:sudo\\s+(?:-\\w+\\s+)*)?(?:command\\s+)?(?:env\\s+)?(?:\\w+=\\S*\\s+)*shred\\s"
      },
      {
        "command_pattern": "(?:^|[\\n;&|`]|\\$\\()\\s*(?:sudo\\s+(?:-\\w+\\s+)*)?(?:command\\s+)?(?:env\\s+)?(?:\\w+=\\S*\\s+)*truncate\\s(?=[^\\n;&|]*\\s(?:-s|--size))"
      },
      {
        "command_pattern": "(?:^|[\\n;&|`]|\\$\\()\\s*(?:sudo\\s+(?:-\\w+\\s+)*)?(?:command\\s+)?(?:env\\s+)?(?:\\w+=\\S*\\s+)*mkfs(\\.\\w+)?\\b"
      },
      {
        "command_pattern": "git\\s+branch(?=[^\\n;&|]*\\s-[a-zA-Z]*D\\b)"
      },
      {
        "command_pattern": "git\\s+branch(?=[^\\n;&|]*\\s--delete\\b)(?=[^\\n;&|]*\\s--force\\b)"
      },
      {
        "command_pattern": "git\\s+push(?=[^\\n;&|]*\\s(?:--delete|-d)\\b)"
      },
      {
        "command_pattern": "git\\s+push\\s+[^\\n;&|]*\\s:\\S"
      },
      {
        "command_pattern": "git\\s+stash\\s+(?:drop|clear)\\b"
      },
      {
        "command_pattern": "git\\s+reflog\\s+expire"
      },
      {
        "command_pattern": "git\\s+gc(?=[^\\n;&|]*\\s--prune)"
      },
      {
        "command_pattern": "git\\s+update-ref(?=[^\\n;&|]*\\s-d\\b)"
      },
      {
        "command_pattern": "git\\s+worktree\\s+remove(?=[^\\n;&|]*\\s--force\\b)"
      },
      {
        "command_pattern": "(?:^|[\\n;&|`]|\\$\\()\\s*(?:sudo\\s+(?:-\\w+\\s+)*)?(?:command\\s+)?(?:env\\s+)?(?:\\w+=\\S*\\s+)*aws\\s+(?:[^\\s;&|]+\\s+)*?ec2\\s+(?:[^\\s;&|]+\\s+)*?(?:terminate-instances|delete-volume|delete-snapshot|deregister-image)\\b"
      },
      {
        "command_pattern": "(?:^|[\\n;&|`]|\\$\\()\\s*(?:sudo\\s+(?:-\\w+\\s+)*)?(?:command\\s+)?(?:env\\s+)?(?:\\w+=\\S*\\s+)*aws\\s+(?:[^\\s;&|]+\\s+)*?rds\\s+(?:[^\\s;&|]+\\s+)*?delete-db-(?:instance|cluster|snapshot|cluster-snapshot)\\b"
      },
      {
        "command_pattern": "(?:^|[\\n;&|`]|\\$\\()\\s*(?:sudo\\s+(?:-\\w+\\s+)*)?(?:command\\s+)?(?:env\\s+)?(?:\\w+=\\S*\\s+)*aws\\s+(?:[^\\s;&|]+\\s+)*?s3\\s+(?:[^\\s;&|]+\\s+)*?(?:rb|rm)\\b"
      },
      {
        "command_pattern": "(?:^|[\\n;&|`]|\\$\\()\\s*(?:sudo\\s+(?:-\\w+\\s+)*)?(?:command\\s+)?(?:env\\s+)?(?:\\w+=\\S*\\s+)*aws\\s+(?:[^\\s;&|]+\\s+)*?s3api\\s+(?:[^\\s;&|]+\\s+)*?delete-(?:bucket|object|objects|bucket-policy)\\b"
      },
      {
        "command_pattern": "(?:^|[\\n;&|`]|\\$\\()\\s*(?:sudo\\s+(?:-\\w+\\s+)*)?(?:command\\s+)?(?:env\\s+)?(?:\\w+=\\S*\\s+)*aws\\s+(?:[^\\s;&|]+\\s+)*?iam\\s+(?:[^\\s;&|]+\\s+)*?delete-(?:user|role|policy|group|instance-profile|access-key)\\b"
      },
      {
        "command_pattern": "(?:^|[\\n;&|`]|\\$\\()\\s*(?:sudo\\s+(?:-\\w+\\s+)*)?(?:command\\s+)?(?:env\\s+)?(?:\\w+=\\S*\\s+)*aws\\s+(?:[^\\s;&|]+\\s+)*?kms\\s+(?:[^\\s;&|]+\\s+)*?(?:schedule-key-deletion|disable-key)\\b"
      },
      {
        "command_pattern": "(?:^|[\\n;&|`]|\\$\\()\\s*(?:sudo\\s+(?:-\\w+\\s+)*)?(?:command\\s+)?(?:env\\s+)?(?:\\w+=\\S*\\s+)*aws\\s+(?:[^\\s;&|]+\\s+)*?backup\\s+(?:[^\\s;&|]+\\s+)*?delete-(?:backup-vault|backup-plan|recovery-point|backup-selection)\\b"
      },
      {
        "command_pattern": "(?:^|[\\n;&|`]|\\$\\()\\s*(?:sudo\\s+(?:-\\w+\\s+)*)?(?:command\\s+)?(?:env\\s+)?(?:\\w+=\\S*\\s+)*aws\\s+(?:[^\\s;&|]+\\s+)*?logs\\s+(?:[^\\s;&|]+\\s+)*?delete-log-(?:group|stream)\\b"
      },
      {
        "command_pattern": "(?:^|[\\n;&|`]|\\$\\()\\s*(?:sudo\\s+(?:-\\w+\\s+)*)?(?:command\\s+)?(?:env\\s+)?(?:\\w+=\\S*\\s+)*aws\\s+(?:[^\\s;&|]+\\s+)*?cloudformation\\s+(?:[^\\s;&|]+\\s+)*?delete-stack\\b"
      },
      {
        "command_pattern": "(?:^|[\\n;&|`]|\\$\\()\\s*(?:sudo\\s+(?:-\\w+\\s+)*)?(?:command\\s+)?(?:env\\s+)?(?:\\w+=\\S*\\s+)*aws\\s+(?:[^\\s;&|]+\\s+)*?dynamodb\\s+(?:[^\\s;&|]+\\s+)*?delete-table\\b"
      },
      {
        "command_pattern": "(?:^|[\\n;&|`]|\\$\\()\\s*(?:sudo\\s+(?:-\\w+\\s+)*)?(?:command\\s+)?(?:env\\s+)?(?:\\w+=\\S*\\s+)*aws\\s+(?:[^\\s;&|]+\\s+)*?ecr\\s+(?:[^\\s;&|]+\\s+)*?(?:delete-repository|batch-delete-image)\\b"
      },
      {
        "command_pattern": "(?:^|[\\n;&|`]|\\$\\()\\s*(?:sudo\\s+(?:-\\w+\\s+)*)?(?:command\\s+)?(?:env\\s+)?(?:\\w+=\\S*\\s+)*gh\\s+repo\\s+delete\\b"
      },
      {
        "command_pattern": "(?:^|[\\n;&|`]|\\$\\()\\s*(?:sudo\\s+(?:-\\w+\\s+)*)?(?:command\\s+)?(?:env\\s+)?(?:\\w+=\\S*\\s+)*gh\\s+release\\s+delete\\b"
      },
      {
        "command_pattern": "(?:^|[\\n;&|`]|\\$\\()\\s*(?:sudo\\s+(?:-\\w+\\s+)*)?(?:command\\s+)?(?:env\\s+)?(?:\\w+=\\S*\\s+)*gh\\s+(?:secret|variable)\\s+(?:delete|remove)\\b"
      },
      {
        "command_pattern": "(?:^|[\\n;&|`]|\\$\\()\\s*(?:sudo\\s+(?:-\\w+\\s+)*)?(?:command\\s+)?(?:env\\s+)?(?:\\w+=\\S*\\s+)*gh\\s+api(?=[^\\n;&|]*\\s(?:-X|--method)[\\s=]+DELETE\\b)"
      },
      {
        "command_pattern": "(?:^|[\\n;&|`]|\\$\\()\\s*(?:sudo\\s+(?:-\\w+\\s+)*)?(?:command\\s+)?(?:env\\s+)?(?:\\w+=\\S*\\s+)*wrangler\\s+(?:[^\\s;&|]+\\s+)*?delete\\b"
      },
      {
        "command_pattern": "(?:^|[\\n;&|`]|\\$\\()\\s*(?:sudo\\s+(?:-\\w+\\s+)*)?(?:command\\s+)?(?:env\\s+)?(?:\\w+=\\S*\\s+)*stripe\\s+\\w[\\w-]*\\s+delete\\b"
      },
      {
        "command_pattern": "\\b(?:FLUSHALL|FLUSHDB)\\b",
        "case_sensitive": false
      }
    ]
  },
  "response": {
    "action": "hard_pause",
    "display": "red_box",
    "message": "⛔ DESTRUCTIVE COMMAND DETECTED — innate-02 fired\n\nCommand: {command}\nTarget: {target}\nReversibility: {reversibility}\n\nWhy this fired: rule innate-02 matches commands capable of\npermanent data loss (rm -rf, force push, drop table, etc.).\nSee rules/innate/02-destructive-confirmation.yaml for the pattern set.\n\nHow to proceed:\n\n  Type `allostat: override` in your next message to authorize THIS\n  one command. Consent is single-use — the guard re-arms immediately\n  after, so every destructive command gets its own confirmation.\n\n  (Legacy escape for non-interactive/bench use: the\n  ALLOSTAT_INNATE_OVERRIDES env var. Editing this rule file is NOT an\n  escape: an edited rule fails its content pin and is DISABLED entirely\n  — destructive coverage drops to a last-resort pattern set — until the\n  file is restored. Ask the agent how to disable a guard instead.)\n\nThe override is logged to .allostat/observations.jsonl as\ninnate_rule_overridden — forensics preserved regardless of which\npath you choose.\n\nIf unsure what's about to be deleted/lost, ask the agent to explain\nBEFORE setting the override.\n"
  },
  "exception_required": "env_var_override_or_rule_edit",
  "why_lethal": "Lost work measured in hours-to-days of recovery. Force-pushed branches may overwrite teammates' commits. Dropped tables = data loss with no recovery without backups.\n"
}
